repeat task.wait() until game:IsLoaded()

if game.PlaceId ~= 128557089580754 then return end

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local VirtualInputManager = game:GetService("VirtualInputManager")

local lp = Players.LocalPlayer
local guiParent = gethui and gethui() or lp:WaitForChild("PlayerGui")
local enemyFolder = workspace:WaitForChild("Enemies"):WaitForChild(lp.Name)
local Camera = workspace.CurrentCamera

local REGISTRY_KEY = "__PeanutHubRegistry"

if _G[REGISTRY_KEY] then
    local old = _G[REGISTRY_KEY]

    for _, t in ipairs(old.threads or {}) do
        pcall(task.cancel, t)
    end

    for _, c in ipairs(old.connections or {}) do
        pcall(function()
            c:Disconnect()
        end)
    end

    _G[REGISTRY_KEY] = nil
end

local activeThreads = {}
local activeConnections = {}

_G[REGISTRY_KEY] = {
    threads = activeThreads,
    connections = activeConnections,
}

local function spawnTracked(fn)
    local t = task.spawn(fn)
    table.insert(activeThreads, t)
    return t
end

local function trackConnection(conn)
    table.insert(activeConnections, conn)
    return conn
end

local existingGui = guiParent:FindFirstChild("PeanutCustomUI")
if existingGui then
    existingGui:Destroy()
end

local CustomUI = loadstring(game:HttpGet("https://raw.githubusercontent.com/xLiqua/CustomUI/refs/heads/main/CustomUI.lua"))()()
local DataClient = require(ReplicatedStorage.Packages.dataservice).client

local Settings = {
    AutoRoll = false,
    AutoRebirth = false,
    AutoBuyZones = true,
    AutoCollect = false,
    AutoTPEnemies = false,
    AntiAFK = true
}

if lp.Name == "ShowayZ" then
    Settings.AutoRoll = true
    Settings.AutoBuyZones = true
    Settings.AutoCollect = true
end

local Zones = {
    "Ice",
    "Desert",
    "Lava",
    "Sakura",
    "Mushroom",
    "Heaven",
    "Candy",
    "Swamp",
    "Tech",
    "Toy",
    "Void"
}

local ZonePrices = {
    Ice = 500,
    Desert = 4000,
    Lava = 36000,
    Sakura = 360000,
    Mushroom = 2880000,
    Heaven = 25920000,
    Candy = 259200000,
    Swamp = 2073600000,
    Tech = 18662400000,
    Toy = 167961600000,
    Void = 1511654400000
}

local ZoneCFrames = {
    Spawn = CFrame.new(8.83907223, 6.08495235, 592.977173),
    Ice = CFrame.new(6.92034864, 6.39787769, 335.32962),
    Desert = CFrame.new(7.72411156, 6.33407784, -3.81444812),
    Lava = CFrame.new(6.01895857, 6.10962105, -255.684387),
    Sakura = CFrame.new(-9.20067883, 6.08495235, -497.096954),
    Mushroom = CFrame.new(-261.987915, 6.01867104, -523.158264),
    Heaven = CFrame.new(-535.032104, 6.01866817, -523.112915),
    Candy = CFrame.new(-805.52124, 6.01867104, -522.864258),
    Swamp = CFrame.new(-1028.66223, 6.01867104, -525.780945),
    Tech = CFrame.new(-1270.89697, 6.02929974, -533.768372),
    Toy = CFrame.new(-1548.08728, 6.01446819, -525.470642),
    Void = CFrame.new(-1825.01111, 6.01446819, -523.428711)
}

local BASE_GEMS_NEEDED = 100
local MAX_REBIRTHS = 500
local TP_THRESHOLD = 20
local AUTO_ROLL_INTERVAL_MIN = 0.25
local AUTO_ROLL_INTERVAL_MAX = 0.5

local AntiAFKKeys = {
    Enum.KeyCode.W,
    Enum.KeyCode.A,
    Enum.KeyCode.S,
    Enum.KeyCode.D,
    Enum.KeyCode.Space
}

local function findRemote(logicalName)
    for _, v in ipairs(ReplicatedStorage:GetDescendants()) do
        if (v:IsA("RemoteEvent") or v:IsA("RemoteFunction")) and v:GetAttribute("LogicalName") == logicalName then
            return v
        end
    end
end

local function getData()
    return DataClient:get()
end

local function getGemsNeeded(rebirths)
    rebirths = math.clamp(math.floor(tonumber(rebirths) or 0), 0, MAX_REBIRTHS)
    return BASE_GEMS_NEEDED * (2 ^ rebirths)
end

local function getPlayerStats()
    local data = getData()
    if not data then
        return 0, 0, 0
    end

    return
        tonumber(data.Coins) or 0,
        tonumber(data.Gems) or 0,
        tonumber(data.Rebirths) or 0
end

local function canRebirth()
    local _, gems, rebirths = getPlayerStats()
    return gems >= getGemsNeeded(rebirths)
end

local function isAreaUnlocked(areaName, data)
    if areaName == "Spawn" then
        return true
    end

    return data and data.OwnedAreas and data.OwnedAreas[areaName] == true
end

local function getHRP()
    local char = lp.Character

    if not char then
        char = lp.CharacterAdded:Wait()
    end

    return char:WaitForChild("HumanoidRootPart", 5)
end

local function getHRPFast()
    local char = lp.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function tpToZone(areaName)
    local cf = ZoneCFrames[areaName]

    if not cf then
        return
    end

    local hrp = getHRP()

    if hrp then
        hrp.CFrame = cf
    end
end

local function getBestUnlockedZone(data)
    for i = #Zones, 1, -1 do
        if isAreaUnlocked(Zones[i], data) then
            return Zones[i]
        end
    end

    return "Spawn"
end

local function tpToEnemy(enemy, allowYield)
    local part = enemy.PrimaryPart or enemy:FindFirstChildWhichIsA("BasePart", true)
    if not part then return end

    local hrp = allowYield and getHRP() or getHRPFast()
    if hrp then
        hrp.CFrame = part.CFrame + Vector3.new(0, 3, 0)
    end
end

trackConnection(enemyFolder.ChildAdded:Connect(function(enemy)
    if Settings.AutoTPEnemies then
        tpToEnemy(enemy, false)
    end
end))

local RollRemote = findRemote("Roll_Request")
local RebirthRemote = findRemote("Rebirth_Request")
local BuyZoneRemote = findRemote("Areas_RequestBuy")
local CollectCoinRemote = findRemote("Enemies_CollectCoin")

local Popups = workspace:WaitForChild("_RNGClientWorldPopups"):WaitForChild("Popups")

local function fireRollButton()
    local button = lp.PlayerGui.MainGui.Middle.Roll

    for _, conn in ipairs(getconnections(button.MouseButton1Click)) do
        conn:Fire()
    end
end

local function invokeRoll()
    RollRemote:InvokeServer()
end

local function fireRebirth()
    RebirthRemote:FireServer()
end

local function collectPopup(popup)
    local uid = popup:GetAttribute("CoinDropUID")

    if uid then
        CollectCoinRemote:FireServer(uid)
    end
end

local function collectExistingPopups()
    if Settings.AutoCollect and CollectCoinRemote then
        for _, popup in ipairs(Popups:GetChildren()) do
            pcall(collectPopup, popup)
        end
    end
end

trackConnection(Popups.ChildAdded:Connect(function(popup)
    if Settings.AutoCollect and CollectCoinRemote then
        pcall(collectPopup, popup)
    end
end))

spawnTracked(function()
    while task.wait(60) do
        pcall(fireRollButton)
    end
end)

spawnTracked(function()
    local rolling = false

    while task.wait(math.random(AUTO_ROLL_INTERVAL_MIN * 100, AUTO_ROLL_INTERVAL_MAX * 100) / 100) do
        if Settings.AutoRoll and RollRemote then
            if not rolling then
                rolling = true
                pcall(invokeRoll)
                rolling = false
            end
        end
    end
end)

spawnTracked(function()
    while task.wait(0.5) do
        if Settings.AutoRebirth and RebirthRemote and canRebirth() then
            pcall(fireRebirth)
        end
    end
end)

local lastTpZone = nil

spawnTracked(function()
    while task.wait(1) do
        if Settings.AutoBuyZones and BuyZoneRemote then
            local data = getData()
            local coins = tonumber(data and data.Coins) or 0

            local boughtZone = nil

            for _, areaName in ipairs(Zones) do
                if not Settings.AutoBuyZones then
                    break
                end

                if not isAreaUnlocked(areaName, data) then
                    local price = ZonePrices[areaName]

                    if price and coins >= price then
                        pcall(function()
                            BuyZoneRemote:FireServer({
                                areaName = areaName
                            })
                        end)

                        boughtZone = areaName

                        task.wait(0.6)

                        data = getData()
                        coins = tonumber(data and data.Coins) or 0
                    else
                        break
                    end
                end
            end

            local targetZone = boughtZone or getBestUnlockedZone(data)
            local shouldTp = (targetZone ~= lastTpZone)

            if not shouldTp then
                local hrp = getHRPFast()
                local targetCF = ZoneCFrames[targetZone]

                if hrp and targetCF then
                    local dist = (hrp.Position - targetCF.Position).Magnitude
                    shouldTp = dist > TP_THRESHOLD
                end
            end

            if shouldTp then
                if boughtZone then
                    task.wait(0.4)
                end

                tpToZone(targetZone)
                lastTpZone = targetZone
            end
        else
            lastTpZone = nil
        end
    end
end)

spawnTracked(function()
    while task.wait(1) do
        collectExistingPopups()
    end
end)

spawnTracked(function()
    local lastAction = tick()

    while task.wait(0.8) do
        if Settings.AntiAFK then
            local now = tick()

            if now - lastAction >= math.random(9, 16) then
                if Camera then
                    local randomAngle = math.rad(math.random(-6, 6))
                    Camera.CFrame = Camera.CFrame * CFrame.Angles(0, randomAngle, 0)
                end

                if math.random(1, 100) <= 50 then
                    local chosenKey = AntiAFKKeys[math.random(#AntiAFKKeys)]

                    VirtualInputManager:SendKeyEvent(true, chosenKey, false, game)

                    task.wait(0.05 + math.random(1, 4) / 100)

                    VirtualInputManager:SendKeyEvent(false, chosenKey, false, game)
                end

                if math.random(1, 100) <= 18 then
                    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Space, false, game)

                    task.wait(0.1)

                    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
                end

                lastAction = now
            end
        end
    end
end)

local Window = CustomUI:CreateWindow({
    Name = "PeanutHub",
    Subtitle = "Auto Roll / Rebirth / Zones / Collect"
})

Window:SetTheme("Crimson")

local Main = Window:CreateTab("Main")

local AutoRollToggle = Main:CreateToggle({
    Name = "Auto Roll",
    CurrentValue = false,
    Callback = function(v)
        Settings.AutoRoll = v
    end
})

Main:CreateToggle({
    Name = "Auto Rebirth",
    CurrentValue = false,
    Callback = function(v)
        Settings.AutoRebirth = v
    end
})

local AutoBuyZonesToggle = Main:CreateToggle({
    Name = "Auto Buy Zones + Smart TP",
    CurrentValue = true,
    Callback = function(v)
        Settings.AutoBuyZones = v
    end
})

local AutoCollectToggle = Main:CreateToggle({
    Name = "Auto Collect",
    CurrentValue = false,
    Callback = function(v)
        Settings.AutoCollect = v

        if v then
            collectExistingPopups()
        end
    end
})

Main:CreateToggle({
    Name = "Auto TP Enemies",
    CurrentValue = false,
    Callback = function(v)
        Settings.AutoTPEnemies = v

        if v then
            for _, enemy in ipairs(enemyFolder:GetChildren()) do
                tpToEnemy(enemy, true)
            end
        end
    end
})

local AntiAFKToggle = Main:CreateToggle({
    Name = "Anti AFK",
    CurrentValue = true,
    Callback = function(v)
        Settings.AntiAFK = v
    end
})

if lp.Name == "ShowayZ" then
    Settings.AutoRoll = true
    Settings.AutoBuyZones = true
    Settings.AutoCollect = true

    AutoRollToggle:Set(true)
    AutoBuyZonesToggle:Set(true)
    AutoCollectToggle:Set(true)
end
